<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PJe-Calc Backup" Width="940" Height="840" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Fundo}"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Texto}"
        UseLayoutRounding="False" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="barraTarefas"/>
  </Window.TaskbarItemInfo>

  <Window.Resources>
    <!-- ============================================================ estilos -->
    <Style x:Key="Cartao" TargetType="Border">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Background" Value="{DynamicResource Superficie}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Item" TargetType="Border">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Background" Value="{DynamicResource SuperficieAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BordaSuave}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>

    <Style x:Key="Suave" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>

    <Style x:Key="BotaoBase" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Background" Value="{DynamicResource Superficie}"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BordaControle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimariaClara}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
      <Setter Property="Background" Value="{DynamicResource Primaria}"/>
      <Setter Property="Foreground" Value="{DynamicResource SobrePrimaria}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PrimariaEscura}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="24,9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimariaEscura}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotaoLink" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimariaTexto}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="c" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- abas em "pílula" -->
    <Style x:Key="Aba" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="18" Padding="16,7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimariaClara}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Primaria}"/>
                <Setter Property="Foreground" Value="{DynamicResource SobrePrimaria}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- cartão de escolha (ex.: tipo de restauração, tema) -->
    <Style x:Key="Opcao" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="10" Padding="16,12" BorderThickness="2" BorderBrush="{DynamicResource Borda}" Background="{DynamicResource SuperficieAlt}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BordaControle}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Primaria}"/>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimariaClara}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- amostra de paleta (círculo colorido) -->
    <Style x:Key="Amostra" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,4,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Width="70" Background="Transparent">
              <Grid Width="40" Height="40" HorizontalAlignment="Center">
                <Ellipse x:Name="anel" Stroke="Transparent" StrokeThickness="3"/>
                <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="{DynamicResource BordaControle}" StrokeThickness="1"/>
              </Grid>
              <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextoSuave}"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="anel" Property="Stroke" Value="{DynamicResource Texto}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <!-- estilo Windows 11: caixa 20×20, contorno fino; o ✓ fica por cima da caixa (fora dela), sem risco de corte -->
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Grid DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center">
                <Border x:Name="caixa" CornerRadius="5" BorderThickness="1"
                        BorderBrush="{DynamicResource BordaControle}" Background="{DynamicResource SuperficieAlt}"/>
                <Path x:Name="marca" Data="M5.6,10.3 L8.7,13.3 L14.6,7" Stroke="{DynamicResource SobrePrimaria}" StrokeThickness="1.7"
                      StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource TextoSuave}"/>
                <Setter TargetName="caixa" Property="Background" Value="{DynamicResource PrimariaClara}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="caixa" Property="Background" Value="{DynamicResource Primaria}"/>
                <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource Primaria}"/>
                <Setter TargetName="marca" Property="Visibility" Value="Visible"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="caixa" Property="Background" Value="{DynamicResource PrimariaEscura}"/>
                <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource PrimariaEscura}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- interruptor (liga/desliga), usado nas Configurações -->
    <Style x:Key="Interruptor" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Grid DockPanel.Dock="Left" Width="40" Height="22" VerticalAlignment="Center">
                <Border x:Name="trilho" CornerRadius="11" BorderThickness="1"
                        BorderBrush="{DynamicResource TextoSuave}" Background="{DynamicResource SuperficieAlt}"/>
                <Ellipse x:Name="botao" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource TextoSuave}">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="desliza" X="0"/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="trilho" Property="Background" Value="{DynamicResource PrimariaClara}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="trilho" Property="Background" Value="{DynamicResource Primaria}"/>
                <Setter TargetName="trilho" Property="BorderBrush" Value="{DynamicResource Primaria}"/>
                <Setter TargetName="botao" Property="Fill" Value="{DynamicResource SobrePrimaria}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="desliza" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="desliza" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="trilho" Property="Background" Value="{DynamicResource PrimariaEscura}"/>
                <Setter TargetName="trilho" Property="BorderBrush" Value="{DynamicResource PrimariaEscura}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaixaTexto" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Superficie}"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BordaControle}"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <TextBlock x:Name="dica" Text="{TemplateBinding Tag}" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextoSuave}" Visibility="Collapsed" IsHitTestVisible="False"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="dica" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Primaria}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Padding="10,7" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimariaClara}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="fundo" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource BordaControle}" BorderThickness="1" CornerRadius="6">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L5,5 L10,0"
                            Stroke="{DynamicResource TextoSuave}" StrokeThickness="1.6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource Primaria}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,7,34,7" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource BordaControle}" BorderThickness="1" CornerRadius="6"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Margin="0,2,0,0">
                  <ScrollViewer><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="4" Margin="2" Background="{DynamicResource Rolagem}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" Focusable="False">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border CornerRadius="4" Margin="2" Background="{DynamicResource Rolagem}"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimariaTexto}"/>
      <Setter Property="Background" Value="{DynamicResource Trilho}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
              <Grid>
                <Rectangle x:Name="PART_Track"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Background="{TemplateBinding Foreground}"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================================================== modelos de itens -->
    <DataTemplate x:Key="ModeloLog">
      <DockPanel Margin="{Binding Margem}">
        <TextBlock DockPanel.Dock="Left" Width="20" Text="{Binding Icone}" Foreground="{Binding Cor}" FontWeight="Bold" FontFamily="Segoe UI Symbol"/>
        <TextBlock Text="{Binding Texto}" Foreground="{Binding Cor}" FontWeight="{Binding Peso}" TextWrapping="Wrap"/>
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModeloVersao">
      <Border Style="{StaticResource Item}">
        <DockPanel>
          <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="{Binding CorEstadoFundo}">
            <TextBlock Text="{Binding TextoEstado}" Foreground="{Binding CorEstadoTexto}" FontSize="12" FontWeight="SemiBold"/>
          </Border>
          <TextBlock DockPanel.Dock="Right" Text="{Binding TextoCalculos}" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <CheckBox IsChecked="{Binding Selecionada, Mode=TwoWay}" IsEnabled="{Binding Selecionavel}">
            <StackPanel>
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Titulo}"/>
              <TextBlock Text="{Binding Pasta}" Foreground="{DynamicResource TextoSuave}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </CheckBox>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- lista de cálculos (com cabeçalhos de grupo) -->
    <DataTemplate x:Key="ModeloCalculo">
      <Grid>
        <!-- cabeçalho da versão: marca/desmarca todos dela e mostra/oculta os cálculos -->
        <Border Visibility="{Binding VisGrupo}" Style="{StaticResource Item}" Margin="0,2,0,6" Padding="14,10"
                Background="{DynamicResource PrimariaClara}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding TextoExpandir}" Tag="{Binding}" Style="{StaticResource BotaoBase}"
                    Padding="12,5" VerticalAlignment="Center" MinWidth="150"/>
            <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Titulo}"/>
                <TextBlock Text="{Binding ResumoGrupo}" Foreground="{DynamicResource TextoSuave}" FontSize="12" Margin="0,1,0,0"/>
              </StackPanel>
            </CheckBox>
          </DockPanel>
        </Border>
        <Border Visibility="{Binding VisItem}" Style="{StaticResource Item}" Margin="18,0,0,5">
          <DockPanel>
            <Border DockPanel.Dock="Right" Visibility="{Binding VisDuplicado}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" Background="{DynamicResource AvisoFundo}">
              <TextBlock Text="{Binding TextoDuplicado}" Foreground="{DynamicResource Aviso}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}">
              <StackPanel>
                <TextBlock><Run FontWeight="SemiBold" Text="{Binding Titulo, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource TextoSuave}" FontSize="12" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </CheckBox>
          </DockPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ModeloVersaoCombo">
      <TextBlock><Run FontWeight="SemiBold" Text="{Binding Titulo, Mode=OneWay}"/><Run Foreground="{DynamicResource TextoSuave}" Text="{Binding PastaEntreParenteses, Mode=OneWay}"/></TextBlock>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ======================================================== cabeçalho -->
    <Border Grid.Row="0" Padding="24,14" Background="{DynamicResource Cabecalho}">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="11" Background="#33FFFFFF" Margin="0,0,16,0">
          <Path Fill="{DynamicResource TextoCabecalho}" Stretch="Uniform" Margin="11"
                Data="M12,2 L20,5.5 L20,11 C20,16 16.6,20.4 12,22 C7.4,20.4 4,16 4,11 L4,5.5 Z M11,7 L11,12.6 L8.7,10.3 L7.3,11.7 L12,16.4 L16.7,11.7 L15.3,10.3 L13,12.6 L13,7 Z"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="PJe-Calc Backup" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextoCabecalho}"/>
          <TextBlock Text="Backup, restauração e migração dos cálculos de todas as versões do PJe-Calc Cidadão deste computador."
                     Foreground="{DynamicResource TextoCabecalhoSuave}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ======================================================== avisos (lembrete / nova versão) -->
    <StackPanel Grid.Row="1" Margin="22,10,22,0">
      <Border x:Name="avisoAtualizacao" Visibility="Collapsed" Background="{DynamicResource PrimariaClara}" BorderBrush="{DynamicResource Primaria}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,6">
        <DockPanel>
          <Button x:Name="btnFecharAtualizacao" DockPanel.Dock="Right" Content="✕" Style="{StaticResource BotaoLink}" Margin="12,0,0,0" Foreground="{DynamicResource TextoSuave}"/>
          <Button x:Name="btnBaixarAtualizacao" DockPanel.Dock="Right" Content="Atualizar agora" Style="{StaticResource BotaoBase}" Padding="12,4"/>
          <Button x:Name="btnNovidades" DockPanel.Dock="Right" Content="O que mudou" Style="{StaticResource BotaoLink}" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="txtAtualizacao" VerticalAlignment="Center" TextWrapping="Wrap" Text="Nova versão disponível."/>
        </DockPanel>
      </Border>
      <Border x:Name="avisoInstalar" Visibility="Collapsed" Background="{DynamicResource PrimariaClara}" BorderBrush="{DynamicResource Primaria}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,6">
        <DockPanel>
          <Button x:Name="btnFecharInstalar" DockPanel.Dock="Right" Content="✕" Style="{StaticResource BotaoLink}" Margin="12,0,0,0" Foreground="{DynamicResource TextoSuave}" ToolTip="Não perguntar de novo"/>
          <Button x:Name="btnInstalar" DockPanel.Dock="Right" Content="Instalar" Style="{StaticResource BotaoBase}" Padding="12,4"/>
          <TextBlock x:Name="txtInstalar" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>
      <Border x:Name="avisoAgenda" Visibility="Collapsed" Background="{DynamicResource ErroFundo}" BorderBrush="{DynamicResource Erro}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,6">
        <DockPanel>
          <Button x:Name="btnFecharAgenda" DockPanel.Dock="Right" Content="✕" Style="{StaticResource BotaoLink}" Margin="12,0,0,0" Foreground="{DynamicResource TextoSuave}"/>
          <Button x:Name="btnAgendaBackup" DockPanel.Dock="Right" Content="Fazer backup agora" Style="{StaticResource BotaoBase}" Padding="12,4"/>
          <Button x:Name="btnAgendaRelatorio" DockPanel.Dock="Right" Content="Ver relatório" Style="{StaticResource BotaoLink}" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          <TextBlock x:Name="txtAgenda" VerticalAlignment="Center" Foreground="{DynamicResource Erro}" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>
      <Border x:Name="avisoLembrete" Visibility="Collapsed" Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,6">
        <DockPanel>
          <Button x:Name="btnFecharLembrete" DockPanel.Dock="Right" Content="✕" Style="{StaticResource BotaoLink}" Margin="12,0,0,0" Foreground="{DynamicResource TextoSuave}"/>
          <Button x:Name="btnLembreteBackup" DockPanel.Dock="Right" Content="Fazer backup agora" Style="{StaticResource BotaoBase}" Padding="12,4"/>
          <TextBlock x:Name="txtLembrete" VerticalAlignment="Center" Foreground="{DynamicResource Aviso}" TextWrapping="Wrap" Text=""/>
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- ======================================================== abas -->
    <DockPanel Grid.Row="2" Margin="22,10,22,0" LastChildFill="False">
      <!-- engrenagem: Configurações, Sobre e Apoie -->
      <RadioButton x:Name="abaConfig" DockPanel.Dock="Right" GroupName="abas" Style="{StaticResource Aba}" Margin="0"
                   ToolTip="Configurações, sobre o programa e apoio" AutomationProperties.Name="Configurações" Padding="0">
        <Path Width="20" Height="20" Stretch="Uniform" Margin="-4,1,-4,1"
              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
          <Path.Data>
            <CombinedGeometry GeometryCombineMode="Exclude">
              <CombinedGeometry.Geometry1>
                <GeometryGroup FillRule="Nonzero">
                  <EllipseGeometry Center="10,10" RadiusX="6.6" RadiusY="6.6"/>
                  <RectangleGeometry Rect="8.2,0.6,3.6,18.8" RadiusX="1" RadiusY="1"/>
                  <RectangleGeometry Rect="8.2,0.6,3.6,18.8" RadiusX="1" RadiusY="1"><RectangleGeometry.Transform><RotateTransform Angle="45" CenterX="10" CenterY="10"/></RectangleGeometry.Transform></RectangleGeometry>
                  <RectangleGeometry Rect="8.2,0.6,3.6,18.8" RadiusX="1" RadiusY="1"><RectangleGeometry.Transform><RotateTransform Angle="90" CenterX="10" CenterY="10"/></RectangleGeometry.Transform></RectangleGeometry>
                  <RectangleGeometry Rect="8.2,0.6,3.6,18.8" RadiusX="1" RadiusY="1"><RectangleGeometry.Transform><RotateTransform Angle="135" CenterX="10" CenterY="10"/></RectangleGeometry.Transform></RectangleGeometry>
                </GeometryGroup>
              </CombinedGeometry.Geometry1>
              <CombinedGeometry.Geometry2>
                <EllipseGeometry Center="10,10" RadiusX="3" RadiusY="3"/>
              </CombinedGeometry.Geometry2>
            </CombinedGeometry>
          </Path.Data>
        </Path>
      </RadioButton>
      <RadioButton x:Name="abaBackup" GroupName="abas" Style="{StaticResource Aba}" Content="Backup" IsChecked="True"/>
      <RadioButton x:Name="abaRestaurar" GroupName="abas" Style="{StaticResource Aba}" Content="Restaurar"/>
      <RadioButton x:Name="abaMigrar" GroupName="abas" Style="{StaticResource Aba}" Content="Migrar entre versões"/>
      <RadioButton x:Name="abaHistorico" GroupName="abas" Style="{StaticResource Aba}" Content="Histórico"/>
    </DockPanel>

    <!-- ================================================================ BACKUP -->
    <Grid x:Name="painelBackup" Grid.Row="3" Margin="22,10,22,6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="passosBackup" Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10"/>

      <!-- passo 1: versões -->
      <Border x:Name="bk1" Grid.Row="1" Style="{StaticResource Cartao}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="btnProcurar" Content="Procurar de novo" Style="{StaticResource BotaoBase}" Margin="0,0,8,0"/>
              <Button x:Name="btnAdicionar" Content="Adicionar pasta…" Style="{StaticResource BotaoBase}" Margin="0,0,8,0"/>
              <Button x:Name="btnPlanilha" Content="Planilha (Excel)…" Style="{StaticResource BotaoBase}"
                      ToolTip="Salva uma planilha com todos os cálculos das versões marcadas (número, reclamante, reclamado, processo e datas)"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Quais versões do PJe-Calc entram no backup?" Style="{StaticResource Titulo}"/>
              <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,0" Text="Se alguma estiver aberta, ela é fechada com segurança e reaberta no final."/>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="txtProcurando" DockPanel.Dock="Top" Style="{StaticResource Suave}" Margin="2,4" Text="Procurando instalações do PJe-Calc no computador…"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstVersoes" ItemsSource="{Binding Instalacoes}" ItemTemplate="{StaticResource ModeloVersao}"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- passo 2: cálculos -->
      <Border x:Name="bk2" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Quais cálculos vão para o backup em .PJC?" Style="{StaticResource Titulo}"/>
            <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,8" Text="Lidos direto do banco de dados, sem abrir o PJe-Calc. O banco completo é sempre copiado inteiro."/>
            <DockPanel>
              <Button x:Name="btnBkNenhum" DockPanel.Dock="Right" Content="Desmarcar todos" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
              <Button x:Name="btnBkTodos" DockPanel.Dock="Right" Content="Marcar todos" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
              <TextBox x:Name="txtFiltroBk" Style="{StaticResource CaixaTexto}" Tag="🔍  Filtrar por nome, número ou processo…"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
              <ComboBox x:Name="cmbOrdemBk" DockPanel.Dock="Right" Width="230" Margin="8,0,0,0" SelectedIndex="0">
                <ComboBoxItem Content="Ordenar por número"/>
                <ComboBoxItem Content="Ordenar por nome"/>
                <ComboBoxItem Content="Mais recentes primeiro"/>
              </ComboBox>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Marcar só os criados nos últimos" VerticalAlignment="Center" Foreground="{DynamicResource TextoSuave}" Margin="2,0,8,0"/>
                <Button x:Name="btnBk7" Content="7 dias" Style="{StaticResource BotaoBase}" Padding="10,5" Margin="0,0,6,0"/>
                <Button x:Name="btnBk30" Content="30 dias" Style="{StaticResource BotaoBase}" Padding="10,5" Margin="0,0,6,0"/>
                <Button x:Name="btnBk90" Content="90 dias" Style="{StaticResource BotaoBase}" Padding="10,5"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
          <TextBlock x:Name="txtStatusBk" DockPanel.Dock="Top" Style="{StaticResource Suave}" Margin="2,0,0,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstCalcBk" ItemsSource="{Binding CalculosBackup}" ItemTemplate="{StaticResource ModeloCalculo}"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- passo 3: destino -->
      <Border x:Name="bk3" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Onde salvar o backup?" Style="{StaticResource Titulo}"/>
          <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,10" Text="Cada backup cria uma pasta nova com a data e a hora; nada é apagado."/>
          <DockPanel>
            <Button x:Name="btnAbrirPasta" DockPanel.Dock="Right" Content="Abrir" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
            <Button x:Name="btnEscolher" DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
            <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding Destino, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
          <TextBlock Text="O que incluir" FontWeight="SemiBold" Margin="0,16,0,8"/>
          <CheckBox IsChecked="{Binding ExportarPjc, Mode=TwoWay}" Margin="0,0,0,8">
            <TextBlock><Run FontWeight="SemiBold" Text="Cálculos em .PJC"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — um arquivo por cálculo, para importar no PJe-Calc"/></TextBlock>
          </CheckBox>
          <CheckBox IsChecked="{Binding CopiarBanco, Mode=TwoWay}">
            <TextBlock><Run FontWeight="SemiBold" Text="Banco de dados completo"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — cópia inteira da versão, conferida após a cópia"/></TextBlock>
          </CheckBox>
          <CheckBox IsChecked="{Binding BackupRapido, Mode=TwoWay}" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Backup rápido"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — exporta só os cálculos novos ou alterados; os que não mudaram são copiados do backup anterior. Cada pasta de backup continua completa."/></TextBlock>
          </CheckBox>
          <TextBlock x:Name="txtResumoBk" Style="{StaticResource Suave}" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>

      <!-- passo 4: execução -->
      <Border x:Name="bk4" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="txtTituloBk" Text="Fazendo backup…" Style="{StaticResource Titulo}"/>
            <TextBlock x:Name="txtEtapaBk" Style="{StaticResource Suave}" Margin="0,2,0,10" Text="Iniciando…"/>
            <ProgressBar x:Name="barraBk" Maximum="1" Value="0"/>
          </StackPanel>
          <Border Margin="0,12,0,0" BorderBrush="{DynamicResource BordaSuave}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SuperficieAlt}">
            <ScrollViewer x:Name="rolagemBk" VerticalScrollBarVisibility="Auto" Padding="10,8">
              <ItemsControl ItemsSource="{Binding LogBackup}" ItemTemplate="{StaticResource ModeloLog}"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="2">
        <Button x:Name="bkVoltar" DockPanel.Dock="Left" Content="← Voltar" Style="{StaticResource BotaoBase}"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="bkExtra" Content="Abrir a pasta" Style="{StaticResource BotaoBase}" Margin="0,0,8,0" Visibility="Collapsed"/>
          <Button x:Name="bkAvancar" Content="Avançar →" Style="{StaticResource BotaoPrimario}"/>
        </StackPanel>
        <TextBlock/>
      </DockPanel>
    </Grid>

    <!-- ============================================================= RESTAURAR -->
    <Grid x:Name="painelRestaurar" Grid.Row="3" Margin="22,10,22,6" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="passosRestaurar" Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10"/>

      <!-- passo 1: tipo -->
      <Border x:Name="rs1" Grid.Row="1" Style="{StaticResource Cartao}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="O que você quer restaurar?" Style="{StaticResource Titulo}"/>
          <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,14" Text="Nos dois casos, uma cópia do banco atual é guardada antes, para você poder desfazer."/>
          <UniformGrid Columns="2">
            <RadioButton x:Name="rsTipoPjc" GroupName="tiporest" Style="{StaticResource Opcao}" IsChecked="True">
              <StackPanel>
                <TextBlock Text="Cálculos (.PJC)" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Suave}" Margin="0,4,0,0" Text="Importa arquivos .PJC escolhidos. Cada um vira um cálculo novo; o programa avisa quando o cálculo parece já existir."/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="rsTipoBanco" GroupName="tiporest" Style="{StaticResource Opcao}" Margin="0">
              <StackPanel>
                <TextBlock Text="Banco de dados completo (.zip)" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Suave}" Margin="0,4,0,0" Text="Volta a versão inteira para como estava no backup. Substitui todos os cálculos atuais dessa versão."/>
              </StackPanel>
            </RadioButton>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- passo 2a: arquivos .PJC -->
      <Border x:Name="rs2pjc" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="btnArquivosPjc" Content="Escolher arquivos…" Style="{StaticResource BotaoBase}" Margin="0,0,8,0"/>
              <Button x:Name="btnPastaPjc" Content="Escolher pasta…" Style="{StaticResource BotaoBase}" Margin="0,0,8,0"/>
              <Button x:Name="btnLimparPjc" Content="Limpar" Style="{StaticResource BotaoBase}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Quais arquivos .PJC?" Style="{StaticResource Titulo}"/>
              <TextBlock x:Name="txtResumoPjc" Style="{StaticResource Suave}" Margin="0,2,0,0" Text="Escolha arquivos ou uma pasta de backup (as subpastas entram também)."/>
            </StackPanel>
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstArquivosPjc" ItemsSource="{Binding ArquivosPjc}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Border Visibility="{Binding VisGrupo}" Style="{StaticResource Item}" Margin="0,2,0,6" Padding="14,10" Background="{DynamicResource PrimariaClara}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding TextoExpandir}" Tag="{Binding}" Style="{StaticResource BotaoBase}" Padding="12,5" VerticalAlignment="Center" MinWidth="150"/>
                        <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}" VerticalAlignment="Center">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Titulo}"/>
                            <TextBlock Text="{Binding ResumoGrupo}" Foreground="{DynamicResource TextoSuave}" FontSize="12" Margin="0,1,0,0"/>
                          </StackPanel>
                        </CheckBox>
                      </DockPanel>
                    </Border>
                    <Border Visibility="{Binding VisItem}" Style="{StaticResource Item}" Margin="18,0,0,5">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Tamanho}" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Origem}" Foreground="{DynamicResource TextoSuave}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </CheckBox>
                      </DockPanel>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- passo 2b: arquivo do banco -->
      <Border x:Name="rs2banco" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Qual backup do banco?" Style="{StaticResource Titulo}"/>
          <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,10" Text="Escolha o arquivo banco-de-dados-pjecalc-….zip de um backup feito por este programa."/>
          <DockPanel>
            <Button x:Name="btnZipBanco" DockPanel.Dock="Right" Content="Escolher arquivo…" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
            <TextBox x:Name="txtZipBanco" Style="{StaticResource CaixaTexto}" IsReadOnly="True"/>
          </DockPanel>
          <TextBlock x:Name="txtInfoZip" Style="{StaticResource Suave}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>

      <!-- passo 3: destino e revisão -->
      <Border x:Name="rs3" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Em qual versão restaurar?" Style="{StaticResource Titulo}"/>
            <ComboBox x:Name="cmbDestinoRs" ItemsSource="{Binding InstalacoesComBanco}" ItemTemplate="{StaticResource ModeloVersaoCombo}" Margin="0,10,0,10"/>
            <Border x:Name="rsAvisoBanco" Background="{DynamicResource AvisoFundo}" BorderBrush="{DynamicResource AvisoBorda}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
              <TextBlock x:Name="txtAvisoBanco" TextWrapping="Wrap" Foreground="{DynamicResource Aviso}"/>
            </Border>
            <TextBlock x:Name="txtStatusRs" Style="{StaticResource Suave}" Margin="2,0,0,6"/>
          </StackPanel>
          <ScrollViewer x:Name="rsListaRevisao" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstRevisaoRs" ItemsSource="{Binding CalculosRestaurar}" ItemTemplate="{StaticResource ModeloCalculo}"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- passo 4: execução -->
      <Border x:Name="rs4" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="txtTituloRs" Text="Restaurando…" Style="{StaticResource Titulo}"/>
            <TextBlock x:Name="txtEtapaRs" Style="{StaticResource Suave}" Margin="0,2,0,10" Text="Iniciando…"/>
            <ProgressBar x:Name="barraRs" Maximum="1" Value="0"/>
          </StackPanel>
          <Border Margin="0,12,0,0" BorderBrush="{DynamicResource BordaSuave}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SuperficieAlt}">
            <ScrollViewer x:Name="rolagemRs" VerticalScrollBarVisibility="Auto" Padding="10,8">
              <ItemsControl ItemsSource="{Binding LogRestaurar}" ItemTemplate="{StaticResource ModeloLog}"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="2">
        <Button x:Name="rsVoltar" DockPanel.Dock="Left" Content="← Voltar" Style="{StaticResource BotaoBase}"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="rsExtra" Content="Abrir a pasta" Style="{StaticResource BotaoBase}" Margin="0,0,8,0" Visibility="Collapsed"/>
          <Button x:Name="rsAvancar" Content="Avançar →" Style="{StaticResource BotaoPrimario}"/>
        </StackPanel>
        <TextBlock/>
      </DockPanel>
    </Grid>

    <!-- ================================================================ MIGRAR -->
    <Grid x:Name="painelMigrar" Grid.Row="3" Margin="22,10,22,6" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel x:Name="passosMigrar" Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10"/>

      <!-- passo 1: origem e destino -->
      <Border x:Name="mg1" Grid.Row="1" Style="{StaticResource Cartao}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="De qual versão para qual versão?" Style="{StaticResource Titulo}"/>
          <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,14" Text="Os cálculos são exportados da versão de origem e importados na de destino. A origem não é alterada; o banco de destino é copiado antes."/>
          <TextBlock Text="Levar os cálculos de" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox x:Name="cmbOrigemMg" ItemsSource="{Binding InstalacoesComBanco}" ItemTemplate="{StaticResource ModeloVersaoCombo}"/>
          <TextBlock Text="Para" FontWeight="SemiBold" Margin="0,14,0,6"/>
          <ComboBox x:Name="cmbDestinoMg" ItemsSource="{Binding InstalacoesComBanco}" ItemTemplate="{StaticResource ModeloVersaoCombo}"/>
          <TextBlock x:Name="txtInfoMg" Style="{StaticResource Suave}" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>

      <!-- passo 2: cálculos -->
      <Border x:Name="mg2" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="txtTituloMg2" Text="Quais cálculos levar?" Style="{StaticResource Titulo}"/>
            <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,8" Text="Os que parecem já existir no destino vêm desmarcados, para não duplicar."/>
            <DockPanel>
              <Button x:Name="btnMgNenhum" DockPanel.Dock="Right" Content="Desmarcar todos" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
              <Button x:Name="btnMgTodos" DockPanel.Dock="Right" Content="Marcar todos" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
              <TextBox x:Name="txtFiltroMg" Style="{StaticResource CaixaTexto}" Tag="🔍  Filtrar por nome, número ou processo…"/>
            </DockPanel>
          </StackPanel>
          <TextBlock x:Name="txtStatusMg" DockPanel.Dock="Top" Style="{StaticResource Suave}" Margin="2,0,0,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstCalcMg" ItemsSource="{Binding CalculosMigrar}" ItemTemplate="{StaticResource ModeloCalculo}"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- passo 3: execução -->
      <Border x:Name="mg3" Grid.Row="1" Style="{StaticResource Cartao}" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="txtTituloMg" Text="Migrando…" Style="{StaticResource Titulo}"/>
            <TextBlock x:Name="txtEtapaMg" Style="{StaticResource Suave}" Margin="0,2,0,10" Text="Iniciando…"/>
            <ProgressBar x:Name="barraMg" Maximum="1" Value="0"/>
          </StackPanel>
          <Border Margin="0,12,0,0" BorderBrush="{DynamicResource BordaSuave}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SuperficieAlt}">
            <ScrollViewer x:Name="rolagemMg" VerticalScrollBarVisibility="Auto" Padding="10,8">
              <ItemsControl ItemsSource="{Binding LogMigrar}" ItemTemplate="{StaticResource ModeloLog}"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="2">
        <Button x:Name="mgVoltar" DockPanel.Dock="Left" Content="← Voltar" Style="{StaticResource BotaoBase}"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="mgExtra" Content="Abrir a pasta" Style="{StaticResource BotaoBase}" Margin="0,0,8,0" Visibility="Collapsed"/>
          <Button x:Name="mgAvancar" Content="Avançar →" Style="{StaticResource BotaoPrimario}"/>
        </StackPanel>
        <TextBlock/>
      </DockPanel>
    </Grid>

    <!-- ============================================================= HISTÓRICO -->
    <Border x:Name="painelHistorico" Grid.Row="3" Margin="22,10,22,6" Style="{StaticResource Cartao}" Visibility="Collapsed">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="btnLimparHist" Content="Limpar antigos…" Style="{StaticResource BotaoBase}" Margin="0,0,8,0"
                    ToolTip="Move para a Lixeira os backups antigos, conforme a regra escolhida em Configurações"/>
            <Button x:Name="btnAtualizarHist" Content="Atualizar" Style="{StaticResource BotaoBase}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Histórico" Style="{StaticResource Titulo}"/>
            <TextBlock x:Name="txtPastaHist" Style="{StaticResource Suave}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
        <TextBox x:Name="txtBuscaHist" DockPanel.Dock="Top" Style="{StaticResource CaixaTexto}" Margin="0,0,0,6"
                 Tag="🔍  Buscar um cálculo dentro dos backups: nome do reclamante ou reclamado, nº do processo…"/>
        <TextBlock x:Name="txtStatusBusca" DockPanel.Dock="Top" Style="{StaticResource Suave}" Margin="2,0,0,6" Visibility="Collapsed"/>
        <TextBlock x:Name="txtSemHist" DockPanel.Dock="Top" Style="{StaticResource Suave}" Margin="2,4" Visibility="Collapsed" Text="Nenhum backup encontrado nesta pasta ainda."/>
        <Grid>
        <ScrollViewer x:Name="rolagemBusca" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <ItemsControl x:Name="lstBusca" ItemsSource="{Binding Busca}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Item}" Padding="14,9" Margin="0,0,0,6">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Mostrar arquivo" Style="{StaticResource BotaoBase}" Tag="{Binding}" Margin="8,0,0,0" Padding="10,5"/>
                      <Button Content="Restaurar" Style="{StaticResource BotaoBase}" Tag="{Binding}" Margin="8,0,0,0" Padding="10,5"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource TextoSuave}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer x:Name="rolagemHist" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="lstHistorico" ItemsSource="{Binding Historico}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Item}" Padding="14,10" Margin="0,0,0,8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Abrir pasta" Style="{StaticResource BotaoBase}" Tag="{Binding}" Margin="8,0,0,0" Padding="10,5" x:Name="hAbrir"/>
                      <Button Content="Restaurar .PJC" Style="{StaticResource BotaoBase}" Tag="{Binding}" Margin="8,0,0,0" Padding="10,5" Visibility="{Binding VisPjc}" x:Name="hPjc"/>
                      <Button Content="Restaurar banco" Style="{StaticResource BotaoBase}" Tag="{Binding}" Margin="8,0,0,0" Padding="10,5" Visibility="{Binding VisBanco}" x:Name="hBanco"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Background="{Binding CorStatus}" Margin="0,6,12,0" VerticalAlignment="Top"/>
                    <StackPanel>
                      <TextBlock><Run FontWeight="SemiBold" FontSize="14" Text="{Binding DataTexto, Mode=OneWay}"/><Run Foreground="{DynamicResource TextoSuave}" Text="{Binding TipoTexto, Mode=OneWay}"/></TextBlock>
                      <TextBlock Text="{Binding Detalhe}" Foreground="{DynamicResource TextoSuave}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ========================================================== CONFIGURAÇÕES -->
    <ScrollViewer x:Name="painelConfig" Grid.Row="3" Margin="22,10,22,6" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Aparência" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Tema" FontWeight="SemiBold" Margin="0,12,0,8"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="temaSistema" GroupName="tema" Style="{StaticResource Opcao}" Tag="Sistema"><TextBlock Text="Seguir o Windows" FontWeight="SemiBold"/></RadioButton>
              <RadioButton x:Name="temaClaro" GroupName="tema" Style="{StaticResource Opcao}" Tag="Claro"><TextBlock Text="Claro" FontWeight="SemiBold"/></RadioButton>
              <RadioButton x:Name="temaEscuro" GroupName="tema" Style="{StaticResource Opcao}" Tag="Escuro"><TextBlock Text="Escuro" FontWeight="SemiBold"/></RadioButton>
            </StackPanel>
            <TextBlock Text="Paleta de cores" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <!-- as amostras são criadas pelo programa a partir de Tema.Paletas -->
            <WrapPanel x:Name="paletas" Orientation="Horizontal"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Avisos ao terminar" Style="{StaticResource Titulo}"/>
            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding Sons, Mode=TwoWay}" Margin="0,12,0,8">
              <TextBlock><Run FontWeight="SemiBold" Text="Sons"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — som de sucesso ou de erro do próprio Windows"/></TextBlock>
            </CheckBox>
            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding Notificacoes, Mode=TwoWay}" Margin="0,0,0,8">
              <TextBlock><Run FontWeight="SemiBold" Text="Notificação do Windows"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — ex.: “Backup concluído: 12 cálculos”"/></TextBlock>
            </CheckBox>
            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding AbrirPastaAoTerminar, Mode=TwoWay}" Margin="0,0,0,8">
              <TextBlock><Run FontWeight="SemiBold" Text="Abrir a pasta do backup ao terminar"/></TextBlock>
            </CheckBox>
            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding ReabrirPjeCalc, Mode=TwoWay}">
              <TextBlock><Run FontWeight="SemiBold" Text="Reabrir o PJe-Calc no final"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — se ele estava aberto e foi fechado para o backup"/></TextBlock>
            </CheckBox>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Backups" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Pasta padrão dos backups" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <DockPanel>
              <Button x:Name="btnEscolherCfg" DockPanel.Dock="Right" Content="Escolher…" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
              <TextBox Style="{StaticResource CaixaTexto}" Text="{Binding Destino, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <DockPanel Margin="0,14,0,0">
              <ComboBox x:Name="cmbDiasLembrete" DockPanel.Dock="Right" Width="130" SelectedIndex="0">
                <ComboBoxItem Content="7 dias" Tag="7"/>
                <ComboBoxItem Content="15 dias" Tag="15"/>
                <ComboBoxItem Content="30 dias" Tag="30"/>
              </ComboBox>
              <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding Lembrete, Mode=TwoWay}">
                <TextBlock><Run FontWeight="SemiBold" Text="Lembrete de backup"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — avisar ao abrir o programa quando o último backup passar de"/></TextBlock>
              </CheckBox>
            </DockPanel>
            <DockPanel Margin="0,14,0,0">
              <ComboBox x:Name="cmbLimpeza" DockPanel.Dock="Right" Width="270"/>
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Limpeza de backups antigos"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — ao terminar um backup, oferece mover os antigos para a Lixeira"/></TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource Suave}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="O backup mais recente sem falhas nunca é apagado. As cópias de segurança feitas antes de restaurações e migrações não entram na limpeza."/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Backup automático" Style="{StaticResource Titulo}"/>
            <TextBlock Style="{StaticResource Suave}" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="Cria uma tarefa no Agendador de Tarefas do Windows. O backup roda com você conectado; se o computador estiver desligado na hora marcada, roda assim que for ligado."/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <RadioButton x:Name="agDiario" GroupName="agenda" Style="{StaticResource Opcao}" Tag="diario"><TextBlock Text="Todos os dias" FontWeight="SemiBold"/></RadioButton>
              <RadioButton x:Name="agSemanal" GroupName="agenda" Style="{StaticResource Opcao}" Tag="semanal"><TextBlock Text="Em dias da semana" FontWeight="SemiBold"/></RadioButton>
            </StackPanel>
            <WrapPanel x:Name="agDias" Margin="2,12,0,0"/>
            <DockPanel Margin="0,10,0,0">
              <TextBlock Text="Horário" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="txtAgHora" Style="{StaticResource CaixaTexto}" Width="80" HorizontalAlignment="Left" Tag="18:00"/>
            </DockPanel>
            <CheckBox x:Name="chkAgLimpar" Style="{StaticResource Interruptor}" Margin="0,12,0,0">
              <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Depois do backup automático, aplicar a limpeza de backups antigos"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — sem perguntar; vão para a Lixeira"/></TextBlock>
            </CheckBox>
            <TextBlock Style="{StaticResource Suave}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Usa a pasta de backups e as versões marcadas na aba Backup. Se o PJe-Calc estiver aberto, uma janela avisa e espera 2 minutos antes de fechá-lo com segurança (dá para adiar)."/>
            <DockPanel Margin="0,12,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btnAgRemover" Content="Desligar" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
                <Button x:Name="btnAgSalvar" Content="Ligar / salvar" Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="txtAgEstado" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Suave}"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Atualizações" Style="{StaticResource Titulo}"/>
            <CheckBox Style="{StaticResource Interruptor}" IsChecked="{Binding VerificarAtualizacoes, Mode=TwoWay}" Margin="0,12,0,10">
              <TextBlock><Run FontWeight="SemiBold" Text="Verificar se há versão nova ao abrir"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — consulta só a página do projeto no GitHub; nenhum dado seu é enviado"/></TextBlock>
            </CheckBox>
            <DockPanel>
              <Button x:Name="btnAtualizarAgora" DockPanel.Dock="Right" Content="Atualizar agora" Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Visibility="Collapsed"/>
              <Button x:Name="btnVerificarAgora" DockPanel.Dock="Right" Content="Verificar agora" Style="{StaticResource BotaoBase}"/>
              <TextBlock x:Name="txtVersao" VerticalAlignment="Center" Style="{StaticResource Suave}"/>
            </DockPanel>
            <DockPanel Margin="0,12,0,0">
              <Button x:Name="btnInstalacao" DockPanel.Dock="Right" Content="Instalar…" Style="{StaticResource BotaoBase}" Margin="8,0,0,0"/>
              <TextBlock x:Name="txtInstalacao" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Suave}"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Cartao}">
          <StackPanel>
            <TextBlock Text="Atalhos do teclado" Style="{StaticResource Titulo}"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Enter" FontWeight="SemiBold" Margin="0,2,24,2"/><TextBlock Grid.Row="0" Grid.Column="1" Text="Avançar / Concluir a etapa" Style="{StaticResource Suave}" Margin="0,2"/>
              <TextBlock Grid.Row="1" Text="Esc" FontWeight="SemiBold" Margin="0,2,24,2"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Voltar uma etapa (ou limpar a busca)" Style="{StaticResource Suave}" Margin="0,2"/>
              <TextBlock Grid.Row="2" Text="Ctrl + F" FontWeight="SemiBold" Margin="0,2,24,2"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Ir para o filtro / a busca da tela atual" Style="{StaticResource Suave}" Margin="0,2"/>
              <TextBlock Grid.Row="3" Text="Ctrl + 1 a 4" FontWeight="SemiBold" Margin="0,2,24,2"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Backup, Restaurar, Migrar, Histórico" Style="{StaticResource Suave}" Margin="0,2"/>
              <TextBlock Grid.Row="4" Text="Ctrl + ," FontWeight="SemiBold" Margin="0,2,24,2"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Configurações (engrenagem)" Style="{StaticResource Suave}" Margin="0,2"/>
              <TextBlock Grid.Row="5" Text="F1" FontWeight="SemiBold" Margin="0,2,24,2"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Ajuda (página do projeto)" Style="{StaticResource Suave}" Margin="0,2"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- sobre -->
        <Border x:Name="cartaoSobre" Style="{StaticResource Cartao}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Sobre o PJe-Calc Backup" Style="{StaticResource Titulo}" VerticalAlignment="Center"/>
              <!-- bandeira do Brasil desenhada (o Windows não mostra a bandeira como emoji) -->
              <Viewbox Width="30" Height="21" Margin="10,1,0,0" VerticalAlignment="Center" ToolTip="Feito no Brasil">
                <Canvas Width="42" Height="30">
                  <Rectangle Width="42" Height="30" Fill="#009C3B" RadiusX="3" RadiusY="3"/>
                  <Polygon Points="21,3.5 38.5,15 21,26.5 3.5,15" Fill="#FFDF00"/>
                  <Ellipse Canvas.Left="13.5" Canvas.Top="7.5" Width="15" Height="15" Fill="#002776"/>
                  <Path Data="M14.1,13.4 Q21,11.3 27.9,16.8" Stroke="White" StrokeThickness="1.4"/>
                </Canvas>
              </Viewbox>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21" Foreground="{DynamicResource Texto}"
                       Text="Este programa nasceu de uma dificuldade real no dia a dia da advocacia: ao instalar uma versão nova do PJe-Calc, os cálculos não vão junto, e a única saída era exportar e importar um por um, manualmente, o que levava horas. O PJe-Calc Backup faz isso de forma automática e segura, com conferência no final."/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Texto}"
                       Text="Projeto independente, gratuito e de código aberto, feito no Brasil."/>
            <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Não oficial: sem vínculo com nenhum TRT, com o CSJT ou com a equipe do PJe-Calc. Tudo roda só neste computador."/>
            <DockPanel Margin="0,12,0,0">
              <Button x:Name="btnLicenca" DockPanel.Dock="Right" Content="Ler a licença" Style="{StaticResource BotaoBase}" Padding="12,5"/>
              <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"><Run FontWeight="SemiBold" Text="Licença MIT"/><Run Foreground="{DynamicResource TextoSuave}" Text="  — software livre: pode usar, copiar, modificar e compartilhar, mantendo o aviso de autoria. É fornecido sem garantia."/></TextBlock>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- apoie -->
        <Border x:Name="cartaoApoie" Style="{StaticResource Cartao}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Top">
              <Border x:Name="qrPix" Background="White" CornerRadius="10" Padding="10" Width="196" Height="196" BorderBrush="{DynamicResource Borda}" BorderThickness="1"/>
              <TextBlock Text="Aponte a câmera do app do banco" Style="{StaticResource Suave}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Path Width="20" Height="18" Stretch="Uniform" Fill="#E0245E" VerticalAlignment="Center" Margin="0,2,10,0"
                      Data="M12,21 C12,21 3,14.6 3,8.6 C3,5.6 5.4,3.5 8,3.5 C9.8,3.5 11.2,4.5 12,6 C12.8,4.5 14.2,3.5 16,3.5 C18.6,3.5 21,5.6 21,8.6 C21,14.6 12,21 12,21 Z"/>
                <TextBlock Text="Apoie este projeto" Style="{StaticResource Titulo}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21" Foreground="{DynamicResource Texto}"
                         Text="O PJe-Calc Backup é gratuito e continuará sendo. Se ele economizou o seu tempo, você pode apoiar o desenvolvimento com um PIX de qualquer valor. Obrigado!"/>
              <TextBlock Text="Chave PIX (aleatória)" FontWeight="SemiBold" Margin="0,14,0,6"/>
              <TextBox x:Name="txtChavePix" Style="{StaticResource CaixaTexto}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="btnCopiarChave" Content="Copiar chave PIX" Style="{StaticResource BotaoPrimario}" Margin="0,0,8,0"/>
                <Button x:Name="btnCopiarPix" Content="Copiar &quot;Pix Copia e Cola&quot;" Style="{StaticResource BotaoBase}"/>
              </StackPanel>
              <TextBlock x:Name="txtPixCopiado" Margin="2,8,0,0" Foreground="{DynamicResource Ok}" FontWeight="SemiBold" Visibility="Collapsed"/>
              <TextBlock Style="{StaticResource Suave}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                         Text="No app do banco: Pix → Pagar com chave (cole a chave) ou Pix Copia e Cola. O nome do recebedor aparece antes de você confirmar."/>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ========================================================= rodapé -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource Borda}" BorderThickness="0,1,0,0" Background="{DynamicResource Rodape}" Padding="24,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="lnkSobre" Content="Sobre" Style="{StaticResource BotaoLink}" Margin="0,0,18,0"/>
          <Button x:Name="lnkApoiar" Style="{StaticResource BotaoLink}" Margin="0,0,18,0" AutomationProperties.Name="Apoiar">
            <StackPanel Orientation="Horizontal">
              <Path Width="13" Height="12" Stretch="Uniform" Fill="#E0245E" VerticalAlignment="Center" Margin="0,1,6,0"
                    Data="M12,21 C12,21 3,14.6 3,8.6 C3,5.6 5.4,3.5 8,3.5 C9.8,3.5 11.2,4.5 12,6 C12.8,4.5 14.2,3.5 16,3.5 C18.6,3.5 21,5.6 21,8.6 C21,14.6 12,21 12,21 Z"/>
              <TextBlock Text="Apoiar"/>
            </StackPanel>
          </Button>
          <Button x:Name="lnkGithub" Content="Código-fonte e ajuda" Style="{StaticResource BotaoLink}"/>
        </StackPanel>
        <TextBlock x:Name="txtRodape" Style="{StaticResource Suave}" FontSize="12" VerticalAlignment="Center" Text="Projeto independente e não oficial. Tudo roda só neste computador."/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
